meta {
  name: validateVatNumber
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/vat/validate
  body: json
  auth: bearer
}

headers {
  Accept: application/json
  Content-Type: application/json
}

auth:bearer {
  token: {{bearerToken}}
}

body:json {
  {
    "country_code": "SE",
    "vat_number": "556016068001"
  }
}

settings {
  encodeUrl: true
  forwardAuthorizationHeader: false
}
