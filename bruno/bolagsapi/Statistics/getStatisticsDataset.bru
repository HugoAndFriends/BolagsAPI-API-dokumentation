meta {
  name: getStatisticsDataset
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/v1/statistics/datasets/{{datasetId}}
  body: none
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{bearerToken}}
}

settings {
  encodeUrl: true
  forwardAuthorizationHeader: false
}
