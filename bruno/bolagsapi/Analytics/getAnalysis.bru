meta {
  name: getAnalysis
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/v1/company/{{orgnr}}/analysis
  body: none
  auth: bearer
}

params:query {
  @description('Language for summary text')
  ~lang: sv
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{bearerToken}}
}

settings {
  encodeUrl: true
  forwardAuthorizationHeader: false
}
