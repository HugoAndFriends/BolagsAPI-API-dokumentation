meta {
  name: downloadAuditorReport
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/v1/company/{{orgnr}}/reports/{{reportId}}/auditor
  body: none
  auth: bearer
}

params:query {
  @description('Output format: pdf (default) or raw for original XHTML')
  ~format: pdf
}

headers {
  Accept: application/pdf, application/xhtml+xml
}

auth:bearer {
  token: {{bearerToken}}
}

settings {
  encodeUrl: true
  forwardAuthorizationHeader: false
}
