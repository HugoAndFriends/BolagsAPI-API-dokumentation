meta {
  name: getWebhookDeliveries
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/v1/webhooks/{{webhookId}}/deliveries
  body: none
  auth: bearer
}

params:query {
  @description('Maximum results (1-100)')
  ~limit: 50
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{bearerToken}}
}

settings {
  encodeUrl: true
  forwardAuthorizationHeader: false
}
