meta {
  name: getPersonBeneficialOf
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/v1/persons/beneficial-of
  body: json
  auth: bearer
}

headers {
  Accept: application/json
  Content-Type: application/json
}

auth:bearer {
  token: {{bearerToken}}
}

body:json {
  {
    "personnummer": "{{personnummer}}"
  }
}

settings {
  encodeUrl: true
  forwardAuthorizationHeader: false
}
