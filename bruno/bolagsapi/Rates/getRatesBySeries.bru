meta {
  name: getRatesBySeries
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/v1/rates/series/{{seriesId}}
  body: none
  auth: bearer
}

params:query {
  @description('Start date (YYYY-MM-DD)')
  ~from: 2026-01-01
  @description('End date (YYYY-MM-DD)')
  ~to: 2026-03-31
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{bearerToken}}
}

settings {
  encodeUrl: true
  forwardAuthorizationHeader: false
}
