meta {
  name: startIdentity
  type: http
  seq: 1
}

post {
  url: {{authBaseUrl}}/api/v1/identify/init
  body: json
  auth: bearer
}

headers {
  Accept: application/json
  Content-Type: application/json
  @description('Visitor IP supplied by your trusted backend/proxy. The first address is used when endUserIp is omitted from the JSON body.')
  ~X-Forwarded-For: 203.0.113.42
}

auth:bearer {
  token: {{identityApiKey}}
}

body:json {
  {
    "scopes": [
      "profile",
      "enrichment:bolag"
    ],
    "endUserIp": "203.0.113.42"
  }
}

settings {
  encodeUrl: true
  forwardAuthorizationHeader: false
}
