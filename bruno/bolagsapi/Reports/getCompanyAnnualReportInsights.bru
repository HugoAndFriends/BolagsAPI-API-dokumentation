meta {
  name: getCompanyAnnualReportInsights
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/v1/company/{{orgnr}}/reports/insights
  body: none
  auth: bearer
}

params:query {
  ~period_end: 
  ~signal_type: 
  ~source: 
  ~year_from: 
  ~year_to: 
  @description('Starter max 50, Pro max 100, Business max 250')
  ~limit: 10
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{bearerToken}}
}

settings {
  encodeUrl: true
  forwardAuthorizationHeader: false
}
