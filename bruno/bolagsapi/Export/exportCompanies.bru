meta {
  name: exportCompanies
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/v1/export
  body: json
  auth: bearer
}

headers {
  Accept: application/json, text/csv
  Content-Type: application/json
  @description('Use a unique key per full export and reuse it with an identical request on retries. Results remain replayable for 24 hours without additional rows, API units or charges. Conflicting or expired keys return 409. Scoped to the paying account and personal/team context.')
  ~Idempotency-Key: {{idempotencyKey}}
}

auth:bearer {
  token: {{bearerToken}}
}

body:json {
  {
    "filters": {
      "sni_codes": [
        "62010"
      ],
      "sni_version": "2007",
      "cities": [
        "Stockholm"
      ],
      "status": "active"
    },
    "preview": true
  }
}

settings {
  encodeUrl: true
  forwardAuthorizationHeader: false
}
