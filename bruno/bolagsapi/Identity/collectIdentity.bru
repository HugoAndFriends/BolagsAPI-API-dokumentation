meta {
  name: collectIdentity
  type: http
  seq: 2
}

get {
  url: {{authBaseUrl}}/api/v1/identify/collect?orderRef={{orderRef}}
  body: none
  auth: bearer
}

params:query {
  orderRef: {{orderRef}}
}

headers {
  Accept: text/event-stream
}

auth:bearer {
  token: {{identityApiKey}}
}

settings {
  encodeUrl: true
  forwardAuthorizationHeader: false
}
