meta {
  name: getAnnouncementById
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/v1/company/{{orgnr}}/announcements/{{announcementId}}
  body: none
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{bearerToken}}
}

settings {
  encodeUrl: true
  forwardAuthorizationHeader: false
}
