meta {
  name: createWebhook
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/v1/webhooks
  body: json
  auth: bearer
}

headers {
  Accept: application/json
  Content-Type: application/json
}

auth:bearer {
  token: {{bearerToken}}
}

body:json {
  {
    "url": "https://example.com/webhook",
    "secret": "{{webhookSecret}}",
    "events": [
      "company.name_changed"
    ]
  }
}

settings {
  encodeUrl: true
  forwardAuthorizationHeader: false
}
