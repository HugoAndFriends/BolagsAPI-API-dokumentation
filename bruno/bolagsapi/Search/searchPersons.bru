meta {
  name: searchPersons
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/v1/search/persons?q=andersson
  body: none
  auth: bearer
}

params:query {
  @description('Name search query (min 2 characters, case-insensitive partial match)')
  q: andersson
  @description('Filter by city')
  ~city: Stockholm
  @description('Filter by gender')
  ~gender: 
  @description('Maximum results to return')
  ~limit: 20
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{bearerToken}}
}

settings {
  encodeUrl: true
  forwardAuthorizationHeader: false
}
