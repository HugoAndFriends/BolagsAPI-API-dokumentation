meta {
  name: getProfessionalContacts
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/v1/company/{{orgnr}}/contacts
  body: none
  auth: bearer
}

params:query {
  @description('Comma-separated. `people` requests named contacts; they are returned only when enabled for your account.')
  ~include: 
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{bearerToken}}
}

settings {
  encodeUrl: true
  forwardAuthorizationHeader: false
}
