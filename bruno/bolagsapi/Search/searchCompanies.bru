meta {
  name: searchCompanies
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/v1/search
  body: none
  auth: bearer
}

params:query {
  @description('Pro. Use immutable market membership instead of q or independent filters. Exact total and orgnr ascending order. Detail fields may be current; selection_as_of identifies frozen membership.')
  ~market_query_id: {{query_id}}
  @description('A valid two-digit industry group or unknown within the market version. Requires market_query_id. Valid absent groups return zero.')
  ~market_industry_code: 38
  @description('Market search cursor only. Cannot be mixed with point cursors or after_orgnr; use the same query/group.')
  ~cursor: REPLACE_WITH_MARKET_SEARCH_CURSOR
  @description('Pro. WGS84 centre latitude. Supply with longitude and radius_km; combines with ordinary search filters, not market_query_id. Only matched, unrestricted visiting addresses can match.')
  ~latitude: 
  @description('WGS84 centre longitude; requires latitude and radius_km.')
  ~longitude: 
  @description('Inclusive great-circle radius in kilometres, greater than zero and at most 500. Requires latitude and longitude. Automatically includes coordinates; existing search ordering applies.')
  ~radius_km: 
  @description('Pro. Include visiting-address coordinates, address_role and geocoding status. No registered-address fallback. Missing/restricted coordinates are null and do not remove results without a radius filter. With market_query_id, returns frozen snapshot coordinates; otherwise current coordinates.')
  ~include_coordinates: false
  @description('Include the SCB profile in every search result. Company lookup always includes it.')
  ~include_scb: false
  @description('Exact stored SCB value. SCB tax activity code. Filters combine with AND; null never matches. Codes retain leading zeros. Protected contact/workplace filters require the corresponding access.')
