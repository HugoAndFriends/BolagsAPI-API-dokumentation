meta {
  name: Get Analysis
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/v1/company/{{orgnr}}/analysis
  body: none
  auth: inherit
}

params:query {
  ~lang: sv
}

docs {
  Get AI-powered financial analysis with credit rating.

  Requires Pro plan or higher.

  Query parameters:
  - lang: Language for summary (sv or en, default: sv)

  Returns:
  - rating: Swedish credit rating (AAA, AA, A, B, C)
  - risk_score: 0-100 where 0=lowest risk
  - summary: AI-generated summary in requested language
  - risk_factors: Array of identified risk factors with severity
  - analyzed_at: Timestamp of analysis

  Results are cached per fiscal year.
}
