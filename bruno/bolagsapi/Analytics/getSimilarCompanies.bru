meta {
  name: getSimilarCompanies
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/v1/company/{{orgnr}}/similar
  body: none
  auth: bearer
}

params:query {
  @description('Maximum number of results (1-100)')
  ~limit: 20
  @description('Only return companies in the same city')
  ~same_city: true
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{bearerToken}}
}

settings {
  encodeUrl: true
  forwardAuthorizationHeader: false
}
