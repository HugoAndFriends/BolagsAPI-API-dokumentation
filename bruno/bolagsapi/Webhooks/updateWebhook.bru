meta {
  name: updateWebhook
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/v1/webhooks/{{webhookId}}
  body: json
  auth: bearer
}

headers {
  Accept: application/json
  Content-Type: application/json
}

auth:bearer {
  token: {{bearerToken}}
}

body:json {
  {
    "active": false
  }
}

settings {
  encodeUrl: true
  forwardAuthorizationHeader: false
}
